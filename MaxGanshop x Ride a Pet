-- ฟังก์ชันยกไข่ที่ออกแบบพิเศษสำหรับ Xeno
-- ==========================================
local function ClaimEgg(targetEgg)
    pcall(function()
        -- วิธีที่ 1: ใช้ fireproximityprompt ถ้าตัวรันรองรับ
        local success = pcall(function()
            for _, obj in pairs(targetEgg.Parent:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    fireproximityprompt(obj)
                end
            end
            for _, obj in pairs(targetEgg:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    fireproximityprompt(obj)
                end
            end
        end)

        -- วิธีที่ 2: ดึง Trigger หรือ Fire Event เผื่อตัวรัน Xeno บล็อกคำสั่ง Prompt
        for _, obj in pairs(targetEgg.Parent:GetDescendants()) do
            if obj:IsA("ClickDetector") then
                fireclickdetector(obj)
            end
        end

        -- วิธีที่ 3: สั่ง TouchPart เพื่อกระตุ้นการเก็บไข่อัตโนมัติทางกายภาพ
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            firetouchinterest(char.HumanoidRootPart, targetEgg, 0)
            task.wait(0.05)
            firetouchinterest(char.HumanoidRootPart, targetEgg, 1)
        end
    end)
end

