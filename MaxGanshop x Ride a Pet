-- ==========================================
-- ตรวจสอบเขตบ้านคนอื่น
-- ==========================================
local function IsInsideAnyBase(position)
    local plots = Workspace:FindFirstChild("Plots") or Workspace:FindFirstChild("Bases") or Workspace:FindFirstChild("PlayerPlots")
    if plots then
        local myUserIdStr = tostring(LocalPlayer.UserId)
        for _, base in pairs(plots:GetChildren()) do
            if base.Name ~= LocalPlayer.Name and base.Name ~= myUserIdStr and not base:GetAttribute("IsOwner") then
                local basePart = base:FindFirstChildWhichIsA("BasePart")
                if basePart then
                    local distance = (Vector3.new(position.X, basePart.Position.Y, position.Z) - basePart.Position).Magnitude
                    if distance < 50 then
                        return true
                    end
                end
            end
        end
    end
    return false
end

