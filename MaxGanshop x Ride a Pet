-- ==========================================
-- 0. ระบบตรวจสอบแมพสมาร์ท
-- ==========================================
local function CheckIsRideAPet()
    local isCorrectMap = false
    local success, gameInfo = pcall(function()
        return MarketplaceService:GetProductInfo(game.PlaceId)
    end)

    if success and gameInfo then
        local gameName = string.lower(gameInfo.Name or "")
        local gameDesc = string.lower(gameInfo.Description or "")
        if (string.find(gameName, "ride") and string.find(gameName, "pet")) or string.find(gameDesc, "ride a pet") then
            isCorrectMap = true
        end
    end

    if not isCorrectMap then
        local hasPlots = Workspace:FindFirstChild("Plots") or Workspace:FindFirstChild("Bases") or Workspace:FindFirstChild("PlayerPlots")
        local hasPets = Workspace:FindFirstChild("Pets") or Workspace:FindFirstChild("Pet") or Workspace:FindFirstChild("Eggs") or Workspace:FindFirstChild("Egg")
        if hasPlots and hasPets then
            isCorrectMap = true
        end
    end

    return isCorrectMap
end

if not CheckIsRideAPet() then
    LocalPlayer:Kick("เฉพาะแมพ Ride a Pet")
    return
end

