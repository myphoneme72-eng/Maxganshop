-- ==========================================
-- ฟังก์ชันบังคับขี่สัตว์ (รองรับ Xeno)
-- ==========================================
local function AutoRidePet()
    pcall(function()
        local mountingEvent = ReplicatedStorage:FindFirstChild("Remotes") 
            and ReplicatedStorage.Remotes:FindFirstChild("Game") 
            and ReplicatedStorage.Remotes.Game:FindFirstChild("Mounting")
        
        if mountingEvent and mountingEvent:IsA("RemoteEvent") then
            mountingEvent:FireServer()
        end

        for _, descendant in pairs(ReplicatedStorage:GetDescendants()) do
            if descendant:IsA("RemoteEvent") or descendant:IsA("UnreliableRemoteEvent") then
                local name = string.lower(descendant.Name)
                if name:find("ride") or name:find("pet") or name:find("mount") or name:find("equip") then
                    pcall(function()
                        descendant:FireServer(true)
                        descendant:FireServer("Ride")
                        descendant:FireServer("Mount")
                    end)
                end
            end
        end
    end)
end

