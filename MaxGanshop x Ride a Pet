local _G_AutoFarm = false

RunService.Stepped:Connect(function()
    if _G_AutoFarm then
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.4)
        if _G_AutoFarm then
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                local hrp = char.HumanoidRootPart
                local humanoid = char:FindFirstChild("Humanoid")

                if not savedSpawnCFrame then
                    UpdateSpawnPosition()
                end

                local basePos = savedSpawnCFrame.Position
                local targetBaseHeightPos = Vector3.new(basePos.X, basePos.Y + 100, basePos.Z)

                local targetEgg = nil
                for _, v in pairs(Workspace:GetDescendants()) do
                    if v:IsA("BasePart") then
                        local nameLower = v.Name:lower()
                        local parentName = v.Parent and v.Parent.Name:lower() or ""
                        
                        if nameLower:find("blackhole") or parentName:find("blackhole") or 
                           nameLower:find("angel") or parentName:find("angel") or 
                           nameLower:find("cherub") or parentName:find("cherub") or
                           nameLower:find("secret") or parentName:find("secret") then
                            
                            if not IsInsideAnyBase(v.Position) then
                                targetEgg = v
                                break
                            end
                        end
                    end
                end

                if not targetEgg then
                    StatusDesc.Text = "Status: No eggs. Hovering at Base..."
                    
                    if humanoid then 
                        humanoid.PlatformStand = false 
                        humanoid:ChangeState(Enum.HumanoidStateType.Running)
                        humanoid.WalkSpeed = 16 
                    end

                    local bvWait = Instance.new("BodyVelocity")
                    bvWait.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bvWait.Velocity = Vector3.new(0, 0, 0)
                    bvWait.Parent = hrp

                    local bgWait = Instance.new("BodyGyro")
                    bgWait.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    bgWait.CFrame = hrp.CFrame
                    bgWait.Parent = hrp

                    while _G_AutoFarm and not targetEgg and (hrp.Position - targetBaseHeightPos).Magnitude > 5 do
                        local dir = (targetBaseHeightPos - hrp.Position).Unit
                        bvWait.Velocity = dir * 450
                        bgWait.CFrame = CFrame.new(hrp.Position, targetBaseHeightPos)
                        
                        for _, v in pairs(Workspace:GetDescendants()) do
                            if v:IsA("BasePart") then
                                local nL = v.Name:lower()
                                local pN = v.Parent and v.Parent.Name:lower() or ""
                                if nL:find("blackhole") or pN:find("blackhole") or nL:find("angel") or pN:find("angel") or nL:find("cherub") or pN:find("cherub") or nL:find("secret") or pN:find("secret") then
                                    if not IsInsideAnyBase(v.Position) then
                                        targetEgg = v
                                        break
                                    end
                                end
                            end
                        end
                        task.wait()
                    end
                    bvWait:Destroy()
                    bgWait:Destroy()

                    hrp.CFrame = CFrame.new(targetBaseHeightPos)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

                else
                    StatusDesc.Text = "Status: Flying to Egg..."
                    
                    if humanoid then 
                        humanoid.PlatformStand = false 
                        humanoid:ChangeState(Enum.HumanoidStateType.Running)
                        humanoid.WalkSpeed = 16 
                    end

                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.Velocity = Vector3.new(0, 0, 0)
                    bv.Parent = hrp

                    local bg = Instance.new("BodyGyro")
                    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    bg.CFrame = hrp.CFrame
                    bg.Parent = hrp

                    local targetPos = targetEgg.Position + Vector3.new(0, 2, 0)
                    while _G_AutoFarm and targetEgg and targetEgg.Parent and (hrp.Position - targetPos).Magnitude > 5 do
                        local direction = (targetPos - hrp.Position).Unit
                        bv.Velocity = direction * 450
                        bg.CFrame = CFrame.new(hrp.Position, targetPos)
                        task.wait()
                    end

                    -- เรียกใช้ระบบเก็บไข่ที่รองรับ Xeno
                    StatusDesc.Text = "Status: Claiming Egg (Xeno Fixed)..."
                    if targetEgg and targetEgg.Parent then
                        ClaimEgg(targetEgg)
                    end
                    task.wait(0.3)

                    StatusDesc.Text = "Status: Firing Mount Remote..."
                    AutoRidePet()
                    task.wait(0.3)

                    if savedSpawnCFrame and _G_AutoFarm then
                        StatusDesc.Text = "Status: Flying back to Base..."

                        local timeout = 0
                        while _G_AutoFarm and (hrp.Position - targetBaseHeightPos).Magnitude > 8 and timeout < 30 do
                            local dir = (targetBaseHeightPos - hrp.Position).Unit
                            bv.Velocity = dir * 450
                            bg.CFrame = CFrame.new(hrp.Position, targetBaseHeightPos)
                            timeout = timeout + 0.05
                            task.wait(0.05)
                        end

                        bv:Destroy()
                        bg:Destroy()
                        
                        hrp.CFrame = CFrame.new(targetBaseHeightPos)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                end
            end)
        else
            StatusDesc.Text = "Status: System Stopped"
        end
    end
end)

